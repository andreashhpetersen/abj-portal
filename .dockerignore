# The build context is the repository root, so that one image can hold both the
# Django app and the SPA bundle built from `frontend/`.

.git/
.github/
**/node_modules/
frontend/dist/
backend/staticfiles/
backend/media/
# Resident-register downloads. Gitignored too, but the build context is the
# repository root, so an uncommitted dump sitting in a working copy would
# otherwise be baked into a published image — six hundred people's names,
# emails and home addresses. The import is handed its file at run time.
backend/data/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/*.sqlite3
.env
.env.*
!.env.example
deploy/
*.md
.idea/
.vscode/
.DS_Store
