# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
venv/
.venv/

# Django
*.sqlite3
backend/staticfiles/
backend/media/

# Node
node_modules/
frontend/dist/
npm-debug.log*

# Environment — .env holds real secrets; .env.example is committed
.env
.env.*
!.env.example

# Secrets the app reads from disk (Google service-account key). The directory
# is committed so the compose mount works; nothing inside it ever is.
deploy/secrets/*
!deploy/secrets/.gitkeep

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
