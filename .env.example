# Copy to .env and fill in. .env is gitignored and never committed.
# Development works with no .env at all — these are the knobs, with dev defaults.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

DJANGO_DEBUG=True

# Required in production; ignored in development (dev pins localhost).
DJANGO_ALLOWED_HOSTS=portal.ab-jaeger.dk

# Defaults to a local SQLite file. Production uses the managed Postgres URL,
# e.g. postgres://user:password@host:25060/dbname?sslmode=require
# DATABASE_URL=postgres://...

# Only needed when the SPA is served from a different origin than the API.
# DJANGO_CORS_ALLOWED_ORIGINS=https://portal.ab-jaeger.dk
# DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.ab-jaeger.dk

# Whether Django serves the built SPA as well as the API. On in production,
# where one origin serves both; off in development, where Vite owns the
# frontend. Set it locally to check the real production bundle.
# DJANGO_SERVE_SPA=True

# --- Outgoing mail ------------------------------------------------------------
# Development writes mail to the console and ignores all of this. In production
# these point at the transactional provider (Scaleway TEM) — never at the
# association's own mailboxes. See INFRASTRUCTURE.md.
# DJANGO_EMAIL_HOST=smtp.tem.scw.cloud
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# Sent from the portal's own subdomain, so automated mail cannot damage the
# reputation of the board's human correspondence.
# DJANGO_DEFAULT_FROM_EMAIL=Beboerportal <no-reply@varsel.ab-jaeger.dk>

# --- Shop-rental applications -------------------------------------------------
# Reading the erhvervslejemål form's responses sheet. All three may be left
# unset: the portal runs fine without them and only `manage.py
# sync_applications` complains. See README.md for the service-account setup —
# the sheet is shared read-only with the service account's own email address.
# SHOPRENTALS_SHEET_ID=<the spreadsheet id from its URL>
# On the server this is the path *inside* the container, which
# deploy/docker-compose.yml mounts from /opt/abj-portal/secrets/. Locally, point
# it straight at wherever you saved the key.
# SHOPRENTALS_GOOGLE_CREDENTIALS=/run/secrets/abj/google-sheets.json
# No sheet name on purpose, so "the first sheet" survives Google naming the tab
# by the form's locale (Formularsvar 1 / Form Responses 1).
# SHOPRENTALS_SHEET_RANGE=A:ZZ

# --- Server only --------------------------------------------------------------
# Everything below is used on the deployment server, by deploy/docker-compose.yml
# and deploy/backup.sh. None of it matters in development.

# Set by the deploy workflow on each release; pin it by hand only to roll back.
# PORTAL_IMAGE=ghcr.io/owner/repo:<sha>
# PORTAL_DOMAIN=portal.ab-jaeger.dk
# Where Let's Encrypt sends expiry warnings.
# ACME_EMAIL=bestyrelse@ab-jaeger.dk

# Nightly encrypted database dumps. The recipient is an age *public* key: the
# server can write backups but not read them. Keep the private key offline and
# in more than one person's hands.
# BACKUP_AGE_RECIPIENT=age1...
# BACKUP_REMOTE=upcloud:abj-portal-backups
# BACKUP_RETENTION_DAYS=90
