# Copy to .env and fill in. .env is gitignored and never committed.
# Development works with no .env at all — these are the knobs, with dev defaults.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

DJANGO_DEBUG=True

# Required in production; ignored in development (dev pins localhost).
DJANGO_ALLOWED_HOSTS=portal.example.dk

# Defaults to a local SQLite file. Production uses the managed Postgres URL,
# e.g. postgres://user:password@host:25060/dbname?sslmode=require
# DATABASE_URL=postgres://...

# Only needed when the SPA is served from a different origin than the API.
# DJANGO_CORS_ALLOWED_ORIGINS=https://portal.example.dk
# DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.example.dk
